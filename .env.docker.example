# Optional overrides for `docker compose up --build`. Everything has a local
# default, so the stack starts with NO .env file. Copy to .env to customise:
#   cp .env.docker.example .env
# (Native, non-Docker development uses .env-example instead.)

# --- Auth -----------------------------------------------------------------
# dev: no sign-in, one fixed seeded user, no Clerk keys needed (local only!).
# clerk: real sign-in; also set both Clerk keys below.
AUTH_PROVIDER=dev
DEV_USER_ID=dev-user
# Required because the images run NODE_ENV=production; compose publishes every
# port on 127.0.0.1 only. Never enable these on a publicly reachable host.
ALLOW_INSECURE_DEV_AUTH=true
DEV_AUTH_HOST_IS_LOOPBACK_ONLY=true
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=

# Deterministic personal access token minted for the dev user at bootstrap
# (hashed in the DB like any token). Scopes: portfolio:read, portfolio:write,
# observations:write. Must start with pu_ and be >= 32 chars. Change it if
# other people can reach your machine.
POINTUP_DEV_TOKEN=pu_dev_local_only_0123456789abcdef0123456789abcdef

# --- Ports (host side; all bound to 127.0.0.1) ------------------------------
# WEB_PORT=3000
# MCP_PORT=8787
# DB_PORT=5432
# PGBOUNCER_PORT=6432

# --- Database ---------------------------------------------------------------
# POSTGRES_PASSWORD=password
# POSTGRES_DB=app
# Pooled connection for web/worker (profile `pgbouncer`); migrations always go
# direct. `npm run docker:up:pgbouncer` sets this for you.
# APP_DATABASE_URL=postgresql://postgres:password@pgbouncer:6432/app

# --- Worker -----------------------------------------------------------------
# WORKER_SYNC_INTERVAL_MINUTES=360
# WORKER_DIGEST_INTERVAL_MINUTES=10080

# --- Optional integrations (all off by default) -------------------------------
# LLM_PROVIDER=openai
# LLM_API_KEY=
# SLACK_WEBHOOK_URL=
