{
  "name": "@pointup/core",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Framework-agnostic domain, application, and infrastructure layers for PointUp",
  "exports": {
    ".": "./src/index.ts",
    "./contracts": "./src/contracts/index.ts",
    "./openapi": "./src/contracts/openapi.ts",
    "./providers": "./src/domain/loyalty/provider.ts",
    "./db/schema": "./src/infrastructure/db/schema.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.700.0",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.9.0",
    "vitest": "^3.0.0"
  }
}
