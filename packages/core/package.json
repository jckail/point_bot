{
  "name": "@pointup/core",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Framework-agnostic domain, application, and infrastructure layers for PointUp",
  "exports": {
    ".": "./src/index.ts",
    "./contracts": "./src/contracts/index.ts",
    "./openapi": "./src/contracts/openapi.ts",
    "./observability": "./src/observability/index.ts",
    "./providers": "./src/domain/loyalty/provider.ts",
    "./db/schema": "./src/infrastructure/db/schema.ts",
    "./assistant-actions": "./src/assistant-actions.ts",
    "./card-products": "./src/domain/loyalty/card-products.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --maxWorkers=2",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.700.0",
    "@opentelemetry/api": "^1.9.1",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.9.0",
    "vitest": "4.1.11"
  }
}
