{
  "name": "@pointup/mcp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Local stdio MCP surface over the PointUp authenticated API",
  "scripts": {
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "esbuild src/index.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@pointup/api-client": "*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0",
    "vitest": "^3.0.0",
    "esbuild": "^0.25.0"
  }
}
