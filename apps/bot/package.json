{
  "name": "@pointup/bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "PointBot chat surface: Slack/Discord commands over @pointup/core use cases",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/index.cjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --maxWorkers=2"
  },
  "dependencies": {
    "@pointup/core": "*",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0",
    "vitest": "4.1.11"
  }
}
