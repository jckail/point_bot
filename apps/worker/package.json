{
  "name": "@pointup/worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Background jobs for PointUp: scheduled balance syncs and email digests",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/index.cjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-ses": "^3.750.0",
    "@clerk/backend": "^2.29.5",
    "@pointup/core": "*",
    "nodemailer": "^8.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^7.0.4",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0"
  }
}
