{
  "manifest_version": 3,
  "name": "PointUp balance capture",
  "version": "1.1.0",
  "description": "Review and record loyalty balances from your signed-in provider tab with an explicit click.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "http://[::1]/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "PointUp"
  }
}
